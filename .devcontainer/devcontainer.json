{
  "name": "SCLA Profile",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {},
  // A HyperFrames preview serves exactly ONE workspace (it needs an index.html in
  // its cwd), so reviewing N videos needs N ports. 3002-3007 = six side by side,
  // handed out by scripts/review.sh (VS Code task "Review lesson videos").
  // Silent: the task prints the links, so nothing should steal focus on launch.
  "forwardPorts": [3002, 3003, 3004, 3005, 3006, 3007],
  "portsAttributes": {
    "3002": { "label": "Lesson preview 1", "onAutoForward": "silent" },
    "3003": { "label": "Lesson preview 2", "onAutoForward": "silent" },
    "3004": { "label": "Lesson preview 3", "onAutoForward": "silent" },
    "3005": { "label": "Lesson preview 4", "onAutoForward": "silent" },
    "3006": { "label": "Lesson preview 5", "onAutoForward": "silent" },
    "3007": { "label": "Lesson preview 6", "onAutoForward": "silent" }
  },
  // Infisical CLI = secrets source of truth (injected at runtime via scripts/with-secrets.sh; never written to .env)
  // ffmpeg required for HeyGen TTS transcode step in synth_narration.py
  "postCreateCommand": "curl -1sLf 'https://artifacts-cli.infisical.com/setup.deb.sh' | sudo -E bash && sudo apt-get install -y infisical ffmpeg",
  // /dev/shm defaults to 64 MB; headless Chrome (hyperframes validate/render) needs >=256 MB
  "postStartCommand": "sudo mount -o remount,size=512M /dev/shm || true"
}
