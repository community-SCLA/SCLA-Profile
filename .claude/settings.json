{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(git:*)",
      "Bash(git worktree remove:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(python3:*)",
      "Bash(./sync.sh)",
      "Bash(./ringer.py:*)"
    ],
    "ask": [],
    "deny": [],
    "additionalDirectories": [
      "/home/codespace/.claude",
      "/workspaces/ringer"
    ]
  },
  "skillOverrides": {
    "onboard": "off"
  },
  "hooks": {},
  "enabledPlugins": {
    "superpowers@superpowers-dev": true
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    }
  }
}
