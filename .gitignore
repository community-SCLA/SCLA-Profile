# MCP / tooling scratch — never commit
.playwright-mcp/
_scratch/

# Playwright saved auth (live session tokens — credential, never commit)
.auth/
auth.json

# Drive-sync build artifacts (generated .docx; see scripts/build-docx.sh)
build/

# OS/editor
.DS_Store
*.swp
.idea/
# .vscode/* (not .vscode/) — git cannot re-include a file inside an EXCLUDED
# directory, so the negation below only works if the directory itself is not
# excluded. tasks.json was force-added before this fix (S15, 2026-07-28).
.vscode/*
!.vscode/tasks.json

# Node (if the team adds tooling later)
node_modules/

# credentials
.env
!.env.example

# Claude Code credential + session state (S14, 2026-07-28). This repo doubles as
# the machine's Codespaces dotfiles repo, so a second clone of it holds a LIVE
# login token at .claude/.credentials.json while settings pre-approve git push.
# These rules make it impossible for any clone to commit that token or the
# session transcripts, snapshots, and backups sitting beside it.
.claude/.credentials.json
.claude/projects/
.claude/shell-snapshots/
.claude/file-history/
.claude/backups/
.claude/sessions/
.claude/statsig/
.claude/todos/
.claude/history.jsonl

# Python cache
__pycache__/
*.pyc

# Video production — per-lesson HyperFrames build workspaces. Local-only:
# generated/derived material per stem (node_modules, voice assets, renders,
# snapshots, QA frame/log dumps, build/render/publish locks) is ignored;
# workspace source (HTML, tokens.yml, meta.json, BUILD-KIT.md) is tracked.
# Retired workspaces move to projects/video-production/_archive/renders-hyperframes/
# (ignored below — _archive/status.md is that tree's index). Approved scripts
# live in projects/video-production/lesson-scripts/ (tracked); rendered videos
# are hosted on Wistia, not committed (decisions/log.md, 2026-07-08).
# The _run/ build kit is listed below too, but its current contents were
# already tracked before this rule existed (the S16 lint check depends on
# them) — the ignore only blocks new files there from auto-staging; do not
# untrack the existing ones.
projects/video-production/renders-hyperframes/*/node_modules/
projects/video-production/renders-hyperframes/*/assets/voice/
projects/video-production/renders-hyperframes/*/assets/fonts/
projects/video-production/renders-hyperframes/*/assets/brand/
projects/video-production/renders-hyperframes/*/renders/
projects/video-production/renders-hyperframes/*/snapshots/
projects/video-production/renders-hyperframes/*/qa/
projects/video-production/renders-hyperframes/*/source-revisions/
projects/video-production/renders-hyperframes/.build-in-progress/
projects/video-production/renders-hyperframes/.render.lock/
projects/video-production/renders-hyperframes/.publish.lock/
projects/video-production/renders-hyperframes/_run/
projects/video-production/lesson-scripts/**/*.mp4
projects/video-production/renders-mp4/**/*.mp4
# QA packets (binary frame dumps + verify summary) staged next to each MP4 —
# local-only like the MP4s themselves (renders-mp4 is "local staging, gitignored")
projects/video-production/renders-mp4/**/*.qa/
# Demo-reel / design-system QA dumps (frames + presence). Same byproduct as the
# per-lesson .qa/ packets above, but written under design-system/ so the rule
# there doesn't catch them. Local-only; the durable output is the templates.
projects/video-production/design-system/qa/
# _archive/ is read-only local provenance and never a routing target
# (.claude/rules/repo-hygiene.md) — QA frame dumps, retired build workspaces,
# voice caches. Keep the tree out of the index entirely. status.md is the one
# tracked file; the negation works because _archive itself is not excluded,
# only its children (same pattern as .vscode/* above).
projects/video-production/_archive/*
!projects/video-production/_archive/status.md

# HyperFrames per-workspace derived caches (regenerated on demand; the render
# workspaces under renders-hyperframes/ already ignore their derived material
# above — this covers experiment/spike projects that ARE tracked)
.thumbnails/
.waveform-cache/
snapshots/
qa-frames*/
projects/video-production/experiments/*/assets/voice/

# Leftover S3/secrets setup artifact (a package listing; user-owned and readable
# — the "root-owned, 0600" claim was wrong). Owner decision 2026-07-28: delete
# the file; rule kept so a regenerated one never gets committed.
.s3_setup_*
