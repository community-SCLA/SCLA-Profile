# MCP / tooling scratch — never commit
.playwright-mcp/
_scratch/

# Playwright saved auth (live session tokens — credential, never commit)
.auth/
auth.json

# Drive-sync build artifacts (generated .docx; see scripts/build-docx.sh)
build/

# OS/editor
.DS_Store
*.swp
.idea/
# .vscode/* (not .vscode/) — git cannot re-include a file inside an EXCLUDED
# directory, so the negation below only works if the directory itself is not
# excluded. tasks.json was force-added before this fix (S15, 2026-07-28).
.vscode/*
!.vscode/tasks.json

# Node (if the team adds tooling later)
node_modules/

# credentials
.env
!.env.example

# Claude Code credential + session state (S14, 2026-07-28). This repo doubles as
# the machine's Codespaces dotfiles repo, so a second clone of it holds a LIVE
# login token at .claude/.credentials.json while settings pre-approve git push.
# These rules make it impossible for any clone to commit that token or the
# session transcripts, snapshots, and backups sitting beside it.
.claude/.credentials.json
.claude/projects/
.claude/shell-snapshots/
.claude/file-history/
.claude/backups/
.claude/sessions/
.claude/statsig/
.claude/todos/
.claude/history.jsonl

# Python cache
__pycache__/
*.pyc

# Ringer lives OUTSIDE this repo at /workspaces/ringer (2026-08-02) — a standalone
# clone of github.com/NateBJones-Projects/ringer with its own .git, per upstream's
# design: the clone is disposable code, state lives in ~/.ringer and ~/.config/ringer.
# This rule is a guard against re-cloning it back inside. Untracked and unignored,
# `git add -A` (which sync.sh runs) stages a nested repo as a bare gitlink with no
# .gitmodules, so clones get an empty dir and no way to fill it.
ringer/

# Video production — per-lesson HyperFrames build workspaces (HTML sources,
# caches, renders). Local-only; approved scripts live in
# projects/video-production/lesson-scripts/ (tracked); rendered videos are hosted
# on Wistia, not committed (decisions/log.md, 2026-07-08).
#
# 2026-08-02: the pipeline was retired to projects/video-production/_archive/,
# so every path below moved under that prefix. The rules follow the files —
# the byproducts are no less local-only for being archived.
projects/video-production/_archive/renders-hyperframes/*
!projects/video-production/_archive/renders-hyperframes/README.md
!projects/video-production/_archive/renders-hyperframes/_run/
projects/video-production/lesson-scripts/**/*.mp4
projects/video-production/_archive/renders-mp4/**/*.mp4
# QA packets (binary frame dumps + verify summary) staged next to each MP4 —
# local-only like the MP4s themselves (renders-mp4 was "local staging, gitignored")
projects/video-production/_archive/renders-mp4/**/*.qa/
# Demo-reel / design-system QA dumps (frames + presence). Same byproduct as the
# per-lesson .qa/ packets above, but written under design-system/ so the rule
# there doesn't catch them. Local-only; the durable output is the templates.
projects/video-production/_archive/design-system/qa/

# HyperFrames per-workspace derived caches (regenerated on demand; the render
# workspaces under _archive/renders-hyperframes/ are wholly gitignored already —
# this covers the archived experiment/spike projects that ARE tracked)
.thumbnails/
.waveform-cache/
snapshots/
qa-frames*/
projects/video-production/_archive/experiments/*/assets/voice/

# Leftover S3/secrets setup artifact (a package listing; user-owned and readable
# — the "root-owned, 0600" claim was wrong). Owner decision 2026-07-28: delete
# the file; rule kept so a regenerated one never gets committed.
.s3_setup_*
