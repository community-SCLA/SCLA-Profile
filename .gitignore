# MCP / tooling scratch — never commit
.playwright-mcp/
_scratch/

# Playwright saved auth (live session tokens — credential, never commit)
.auth/
auth.json

# Drive-sync build artifacts (generated .docx; see scripts/build-docx.sh)
build/

# OS/editor
.DS_Store
*.swp
.idea/
# .vscode/* (not .vscode/) — git cannot re-include a file inside an EXCLUDED
# directory, so the negation below only works if the directory itself is not
# excluded. tasks.json was force-added before this fix (S15, 2026-07-28).
.vscode/*
!.vscode/tasks.json

# Node (if the team adds tooling later)
node_modules/

# credentials
.env
!.env.example

# Claude Code credential + session state (S14, 2026-07-28). This repo doubles as
# the machine's Codespaces dotfiles repo, so a second clone of it holds a LIVE
# login token at .claude/.credentials.json while settings pre-approve git push.
# These rules make it impossible for any clone to commit that token or the
# session transcripts, snapshots, and backups sitting beside it.
.claude/.credentials.json
.claude/projects/
.claude/shell-snapshots/
.claude/file-history/
.claude/backups/
.claude/sessions/
.claude/statsig/
.claude/todos/
.claude/history.jsonl

# Python cache
__pycache__/
*.pyc

# Video production — per-lesson HyperFrames build workspaces (HTML sources,
# caches, renders). Local-only: active builds live in renders-hyperframes/<stem>/,
# delivered ones move to renders-hyperframes/_archive/<stem>/ (see that folder's
# README.md). Approved scripts live in projects/video-production/lesson-scripts/
# (tracked); rendered videos are hosted on Wistia, not committed
# (decisions/log.md, 2026-07-08).
projects/video-production/renders-hyperframes/*
!projects/video-production/renders-hyperframes/README.md
projects/video-production/lesson-scripts/**/*.mp4
projects/video-production/renders-mp4/**/*.mp4
# QA packets (binary frame dumps + verify summary) staged next to each MP4 —
# local-only like the MP4s themselves (renders-mp4 is "local staging, gitignored")
projects/video-production/renders-mp4/**/*.qa/
# Demo-reel / design-system QA dumps (frames + presence). Same byproduct as the
# per-lesson .qa/ packets above, but written under design-system/ so the rule
# there doesn't catch them. Local-only; the durable output is the templates.
projects/video-production/design-system/qa/

# HyperFrames per-workspace derived caches (regenerated on demand; the render
# workspaces under renders-hyperframes/ are wholly gitignored already — this
# covers experiment/spike projects that ARE tracked)
.thumbnails/
.waveform-cache/
snapshots/
qa-frames*/
projects/video-production/experiments/*/assets/voice/

# Leftover S3/secrets setup artifact (a package listing; user-owned and readable
# — the "root-owned, 0600" claim was wrong). Owner decision 2026-07-28: delete
# the file; rule kept so a regenerated one never gets committed.
.s3_setup_*
