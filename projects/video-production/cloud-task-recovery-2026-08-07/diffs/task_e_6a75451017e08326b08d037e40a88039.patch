+<script>
+  const compositionId = 'm5_testing-your-next-chapter';
+  const duration = 134;
+  const timeline = gsap.timeline({ paused: true });
+  document.querySelectorAll('.clip').forEach((clip) => {
+    const start = Number(clip.dataset.start);
+    const length = Number(clip.dataset.duration);
+    const inner = clip.querySelector('.inner');
+    timeline.set(clip, { autoAlpha: 1 }, start)
+      .fromTo(inner, { autoAlpha: 0, y: 28 }, { autoAlpha: 1, y: 0, duration: .55, ease: 'power2.out' }, start)
+      .to(inner, { autoAlpha: 0, y: -12, duration: .3, ease: 'power1.in' }, start + length - .3)
+      .set(clip, { autoAlpha: 0 }, start + length);
+  });
+  timeline.to('.progress', { scaleX: 1, duration, ease: 'none' }, 0);
+  window.__timelines = window.__timelines || {};
+  window.__timelines['m5_testing-your-next-chapter'] = timeline;
+  window.__HYPERFRAMES__ = window.__HYPERFRAMES__ || {};
+  window.__HYPERFRAMES__[compositionId] = { timeline, duration, fps: 30 };
+  window.hyperframes = window.hyperframes || {};
+  window.hyperframes.registerTimeline?.(compositionId, timeline);
