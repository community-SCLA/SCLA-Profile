+    .commit { max-width:1420px; padding:48px 56px; border-radius:12px; background:var(--paper); color:var(--navy); font-size:54px; font-weight:800; }
+    .next { margin-top:38px; color:var(--gold); font-size:34px; font-weight:900; }
+    .route { position:absolute; left:120px; right:120px; bottom:64px; display:flex; align-items:center; justify-content:space-between; }
+    .route::before { content:''; position:absolute; left:20px; right:20px; height:4px; background:var(--blue); opacity:.55; }
+    .node { z-index:1; display:grid; place-items:center; width:56px; height:56px; border:4px solid var(--paper); border-radius:50%; background:var(--navy); color:var(--paper); font-size:22px; font-weight:900; }
+  </style>
+</head>
