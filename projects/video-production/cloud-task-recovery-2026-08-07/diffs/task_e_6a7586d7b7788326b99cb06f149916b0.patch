+<style>
+@font-face{font-family:"Proxima Nova";src:url("assets/fonts/proxima-nova-400.woff2") format("woff2");font-weight:400;font-style:normal}
+@font-face{font-family:"Proxima Nova";src:url("assets/fonts/proxima-nova-700.woff2") format("woff2");font-weight:700;font-style:normal}
+@font-face{font-family:"Proxima Nova";src:url("assets/fonts/proxima-nova-900.woff2") format("woff2");font-weight:900;font-style:normal}
+:root{--navy:#0d2437;--deep:#0a1e2f;--blue:#3393d6;--gold:#eaab2d;--paper:#fff;--cultured:#f6f6f9;--muted:#98a4cc}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--deep);font-family:"Proxima Nova",system-ui,sans-serif}.composition{position:relative;width:1920px;height:1080px;overflow:hidden;background:var(--navy);color:var(--paper)}.chrome{position:absolute;left:120px;right:120px;top:58px;display:flex;align-items:center;justify-content:space-between;font-size:22px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}.brand-rule{width:260px;height:4px;background:var(--gold)}.clip{position:absolute;inset:0;padding:150px 120px 120px;display:flex;opacity:0;align-items:center}.scene{width:100%}.eyebrow{font-size:24px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-bottom:26px}.headline{font-size:92px;line-height:.96;font-weight:900;letter-spacing:-.035em;max-width:1460px;margin:0}.sub{font-size:44px;line-height:1.2;max-width:1450px;color:var(--cultured);margin:36px 0 0}.cards{display:flex;gap:24px;margin-top:54px}.card{flex:1;min-height:170px;border:2px solid var(--blue);border-radius:12px;padding:30px;font-size:34px;font-weight:700;background:rgba(10,30,47,.62)}.gold{color:var(--gold)}.split{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:42px}.panel{border-radius:12px;padding:36px;background:var(--cultured);color:var(--deep)}.panel h3{font-size:34px;margin:0 0 22px}.panel p{font-size:30px;line-height:1.25;margin:0}.path{display:flex;align-items:center;gap:14px;margin-top:52px}.node{border:3px solid var(--blue);border-radius:100px;padding:20px 27px;font-size:27px;font-weight:700}.arrow{color:var(--gold);font-size:38px}.question{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px}.q{padding:34px;border-top:4px solid var(--blue);font-size:38px;font-weight:700}.resolve{margin-top:40px;font-size:54px;font-weight:900;color:var(--gold)}.narration{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.experiment{display:inline-block;margin-top:44px;padding:22px 34px;border-radius:100px;background:var(--gold);color:var(--deep);font-size:38px;font-weight:900}
