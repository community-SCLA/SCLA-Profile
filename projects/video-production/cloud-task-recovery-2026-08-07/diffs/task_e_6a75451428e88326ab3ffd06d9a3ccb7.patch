+  logo-blue: "#55A4DD"
+
+typography:
+  display: "proxima-nova"
+  body: "proxima-nova"
+  fallback: "'Proxima Nova', system-ui, sans-serif"
+  weights: [400, 700, 900]
+  scale:
+    display: "96-120px / 900"
+    heading: "60-72px / 900"
+    quote: "52-60px / 700"
+    body: "40-48px / 400"
+    label: "20-26px / 700, uppercase, letter-spacing 0.14em"
+    stat: "200-260px / 900"
+  min-size:
