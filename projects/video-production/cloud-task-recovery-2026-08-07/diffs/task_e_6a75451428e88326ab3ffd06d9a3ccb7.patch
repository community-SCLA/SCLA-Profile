+    label: 20
+    exempt: "marker numerals sized by their circle; declare text-floor-exempt"
+
+spacing:
+  frame-padding: 120
+  safe-area: 72
+  footer-reserve: 120
+  content-bottom: 960
+  card-gutter: 24
+  radius-card: "12px"
+  radius-pill: "100px"
+
+chrome-regions: ["100,50,700,110"]
+
+components:
+  cta-label: "gold text 900 with leading arrow; no fill"
+  chip: "2px blue border; transparent fill; blue text; radius 100px"
+  step-node: "120px circle; 4px navy ring; gold active fill; navy 900 number"
+  point-marker: "74px circle; gold fill; navy 900 number"
+  rule: "gold or blue; 3-4px; scaleX entrance from left"
+
+motion:
+  entrance: "0.4-0.6s per element; whole entrance settled by 1.2s"
+  exit: "0.3s content-layer exit; furniture remains; outro exempt"
+  closing-beat: "one additive resolve in the final second"
+  stagger: "0.12-0.18s"
+  ambient: "finite 3-4s yoyo"
+  ban: "infinite repeats; linear full-screen gradients on navy"
+
+voice:
