+<script type="module">
+  const compositionId = 'm2_mid-career-mindsets-and-limiting-beliefs';
+  const root = document.getElementById(compositionId);
+  const clips = [...root.querySelectorAll('.clip')];
+  const progress = root.querySelector('.progress');
+  const duration = 86.4;
+  function seek(time) {
+    const t = Math.max(0, Math.min(duration, Number(time) || 0));
+    progress.style.transform = `scaleX(${t / duration})`;
+    clips.forEach((clip) => {
+      const start = Number(clip.dataset.start);
+      const end = start + Number(clip.dataset.duration);
+      const active = t >= start && (t < end || (t === duration && end === duration));
+      clip.style.visibility = active ? 'visible' : 'hidden';
+      if (!active) { clip.style.opacity = '0'; clip.style.transform = 'translateY(0)'; return; }
+      const local = t - start;
+      const fadeIn = Math.min(1, local / .55);
+      const remaining = end - t;
+      const fadeOut = end === duration ? 1 : Math.min(1, remaining / .3);
+      clip.style.opacity = String(Math.min(fadeIn, fadeOut));
+      clip.style.transform = `translateY(${(1 - fadeIn) * 22}px)`;
+    });
+  }
+  const timeline = gsap.timeline({ paused: true });
+  timeline.to('.progress', { scaleX: 1, duration, ease: 'none' }, 0);
+  timeline.eventCallback('onUpdate', () => seek(timeline.time()));
+  timeline.id = compositionId;
+  window.__timelines = window.__timelines || {};
+  window.__timelines['m2_mid-career-mindsets-and-limiting-beliefs'] = timeline;
+  window.__hyperframes = window.__hyperframes || {};
+  window.__hyperframes[compositionId] = timeline;
+  window.__HYPERFRAMES_TIMELINES__ = window.__HYPERFRAMES_TIMELINES__ || {};
+  window.__HYPERFRAMES_TIMELINES__[compositionId] = timeline;
