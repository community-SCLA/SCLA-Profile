+  beats.forEach(({id,s,d})=>{tl.set(`#${id}`,{opacity:1},s).from(`#${id}>*:not(.narration)`,{opacity:0,y:28,duration:.55,stagger:.12,ease:"power2.out"},s+.15).to(`#${id}`,{opacity:0,duration:.3},s+d-.3)});
