+    const start = Number(clip.dataset.start);
+    const duration = Number(clip.dataset.duration);
+    timeline.set(clip,{autoAlpha:1},start)
+      .fromTo(clip.children,{y:24,opacity:0},{y:0,opacity:1,duration:.55,stagger:.14,ease:'power2.out'},start+.1)
+      .to(clip.children,{y:-12,opacity:0,duration:.3,ease:'power2.in'},start+duration-.35)
+      .set(clip,{autoAlpha:0},start+duration);
+  });
+  timeline.fromTo('#closing-question .line',{scaleX:0},{scaleX:1,duration:1,ease:'power2.out'},194.8);
+  timeline.duration(196);
+  window.__timelines = window.__timelines || {};
+  window.__timelines['m4_finding-new-peers-sponsors-and-opportunity-holders'] = timeline;
+  window.__HYPERFRAMES__ = window.__HYPERFRAMES__ || {};
+  window.__HYPERFRAMES__.compositions = window.__HYPERFRAMES__.compositions || {};
+  window.__HYPERFRAMES__.compositions[id] = {id,timeline,duration:196,seek:(time)=>timeline.time(time,false)};
