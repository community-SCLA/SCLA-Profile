+<script>
+window.gsap = {
+  timeline: () => {
+    let current = 0;
+    let total = 0;
+    const api = {
+      set(){ return api; }, fromTo(){ return api; }, to(){ return api; },
+      duration(value){ if (value !== undefined) { total = value; return api; } return total; },
+      paused(){ return true; },
+      time(value){
+        if (value === undefined) return current;
+        current = Math.max(0, Math.min(total, Number(value) || 0));
+        document.querySelectorAll('.clip').forEach((clip) => {
+          const start = Number(clip.dataset.start), end = start + Number(clip.dataset.duration);
+          const active = current >= start && current < end;
+          clip.style.visibility = active ? 'visible' : 'hidden';
+          clip.style.opacity = active ? '1' : '0';
+          Array.from(clip.children).forEach((child, index) => {
+            const entered = current >= start + .1 + index * .14;
+            child.style.opacity = active && entered ? '1' : '0';
+            child.style.transform = active && entered ? 'translateY(0)' : 'translateY(24px)';
+          });
+        });
+        document.querySelectorAll('#closing-question .line').forEach((line) => {
+          line.style.transform += current >= 194.8 ? ' scaleX(1)' : ' scaleX(0)';
+        });
+        return api;
+      }
+    };
+    return api;
+  }
+};
+</script>
