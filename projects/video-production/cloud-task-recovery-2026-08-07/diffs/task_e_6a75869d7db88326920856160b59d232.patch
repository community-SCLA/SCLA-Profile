+<div class="eyebrow">MID-CAREER MOMENTUM · MODULE 3</div><div class="scene-grid"><div><h1>The Test</h1><div class="rule"></div></div><div class="visual"><div class="question-mark">?</div></div></div><div class="progress"><span>12</span><b style="width:100.00%"></b><span>12</span></div></section></main><script src="./assets/gsap.min.js"></script><script>
+(function(){
+  const id='m3_from-history-to-signal';
+  const root=document.getElementById(id);
+  const scenes=Array.from(root.querySelectorAll('.scene'));
+  const total=Number(root.dataset.duration);
+  const timelineCore={
+    _time:0,
+    paused:true,
+    duration(value){ return typeof value==='number' ? total : total; },
+    pause(value){ this.paused=true; if(typeof value==='number') this.time(value); return this; },
+    seek(value){ return this.time(value); },
+    progress(value){ if(typeof value!=='number') return this._time/total; return this.time(value*total); },
+    time(value){
+      if(typeof value!=='number') return this._time;
+      this._time=Math.max(0,Math.min(value,total));
+      scenes.forEach((scene)=>{
+        const start=Number(scene.dataset.start), duration=Number(scene.dataset.duration);
+        const local=this._time-start;
+        const active=local>=0 && local<duration;
+        scene.style.visibility=active?'visible':'hidden';
+        if(!active){ scene.style.opacity='0'; return; }
+        const enter=Math.min(1,local/.55);
+        const exit=Math.min(1,Math.max(0,(duration-local)/.3));
+        scene.style.opacity=String(Math.min(enter,exit));
+        const drift=28*(1-enter)+Math.sin(local*1.4)*7;
+        const sway=Math.cos(local*1.1)*6;
+        scene.querySelector('.scene-grid').style.transform=`translate(${sway}px,${drift}px)`;
+        scene.querySelector('.rule').style.transform=`scaleX(${enter})`;
+      });
+      return this;
+    }
+  };
+  const gsap={timeline:()=>timelineCore};
+  const timeline=gsap.timeline({ paused: true });
+  timeline.pause(0);
+  window.__timelines=window.__timelines||{};
+  window.__timelines['m3_from-history-to-signal']=timeline;
+  window.__HYPERFRAMES__=window.__HYPERFRAMES__||{};
+  window.__HYPERFRAMES__[id]={id,root,timeline,duration:total,fps:30,seek:(time)=>timeline.time(time).pause()};
+  window.__hyperframes=window.__HYPERFRAMES__;
+})();
+</script></body></html>
