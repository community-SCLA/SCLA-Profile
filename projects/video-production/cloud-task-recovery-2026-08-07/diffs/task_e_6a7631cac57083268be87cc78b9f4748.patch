+      .fromTo(clip.children, { y: 34, opacity: 0 }, { y: 0, opacity: 1, duration: 0.55, ease: "power2.out" }, start + 0.1)
+      .to(clip.children, { y: -18, opacity: 0, duration: 0.3, ease: "power1.in" }, start + duration - 0.3)
+      .set(clip, { autoAlpha: 0 }, start + duration);
+  });
+  timeline.to(root.querySelector(".progress"), { width: "100%", duration: 174, ease: "none" }, 0);
+  timeline.pause(0);
+  window.__timelines = window.__timelines || {};
+  window.__timelines['m3_how-to-reposition-your-career'] = timeline;
+  window.__HYPERFRAMES__ = window.__HYPERFRAMES__ || {};
+  window.__HYPERFRAMES__[id] = { timeline, duration: 174, fps: 30, seek: (time) => timeline.time(time).pause() };
+  window.dispatchEvent(new CustomEvent("hyperframes:ready", { detail: { compositionId: id, timeline } }));
+</script>
