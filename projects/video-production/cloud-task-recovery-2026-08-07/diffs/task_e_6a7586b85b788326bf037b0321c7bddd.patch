+  window.__renderAt = (time) => {
+    const playhead = Math.max(0, Math.min(150, Number(time) || 0));
+    clips.forEach((clip) => {
+      const start = Number(clip.dataset.start);
+      const end = start + Number(clip.dataset.duration);
+      const local = playhead - start;
+      const active = playhead >= start && playhead < end;
+      clip.style.visibility = active ? 'visible' : 'hidden';
+      clip.style.opacity = active ? String(Math.min(1, Math.max(0, local / .65, (end - playhead) / .3))) : '0';
