+  const duration = 170;
+  const clips = [...document.querySelectorAll('.clip')];
+  const timeline = gsap.timeline({ paused: true });
+  clips.forEach((clip) => {
+    const start = Number(clip.dataset.start);
+    const end = Number(clip.dataset.end);
+    const inner = [...clip.children].filter((node) => !node.classList.contains('sr-narration'));
+    timeline.set(clip, { autoAlpha: 1 }, start);
+    timeline.fromTo(inner, { autoAlpha: 0, y: 30 }, { autoAlpha: 1, y: 0, duration: .55, stagger: .14, ease: 'power2.out' }, start + .05);
+    timeline.to(inner, { autoAlpha: 0, y: -18, duration: .3, ease: 'power1.in' }, Math.max(start + .8, end - .3));
+    timeline.set(clip, { autoAlpha: 0 }, end);
+  });
+  timeline.fromTo('.rail-fill', { scaleX: 0 }, { scaleX: 1, duration, ease: 'none' }, 0);
+  timeline.fromTo('.rail-dot', { x: 0 }, { x: 1660, duration, ease: 'none' }, 0);
+  timeline.to('#beat-15 .finish', { textShadow: '0 0 34px rgba(234,171,45,.5)', duration: 1, ease: 'power2.out' }, duration - 1);
+  window.__timelines = window.__timelines || {};
+  window.__timelines['m6_youve-built-momentum'] = timeline;
+  window.__HYPERFRAMES__ = window.__HYPERFRAMES__ || {};
+  window.__HYPERFRAMES__[compositionId] = { id: compositionId, duration, timeline, seek: (time) => timeline.time(Math.max(0, Math.min(duration, time))).pause() };
+  window.__hyperframesTimeline = timeline;
+  window.hyperframes = window.hyperframes || {};
+  window.hyperframes.registerTimeline?.(compositionId, timeline);
