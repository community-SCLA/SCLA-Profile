+function clamp(value,min,max){return Math.max(min,Math.min(max,value));}
+function renderAt(time){
+  scenes.forEach((scene)=>{
+    const start=Number(scene.dataset.start), duration=Number(scene.dataset.duration), local=time-start;
+    const copy=scene.querySelector('.copy'), dot=scene.querySelector('.signal-dot'), route=scene.querySelector('.route');
+    const visible=local>=0&&local<duration;
+    scene.style.visibility=visible?'visible':'hidden';
+    scene.style.opacity=visible?String(local>duration-.3?clamp((duration-local)/.3,0,1):1):'0';
+    const enter=clamp(local/.55,0,1);
+    copy.style.opacity=String(enter); copy.style.transform=`translateY(${36*(1-enter)}px)`;
+    const dotIn=clamp((local-.12)/.5,0,1); dot.style.opacity=String(dotIn); dot.style.transform=`scale(${.3+.7*dotIn})`;
+    route.style.transform=`scaleX(${clamp((local-.25)/.7,0,1)})`;
+  });
+  document.querySelector('.progress span').style.transform=`scaleX(${clamp(time/totalDuration,0,1)})`;
+}
+const playhead={time:0};
+const timeline=gsap.timeline({paused:true});
+timeline.to(playhead,{time:totalDuration,duration:totalDuration,ease:'none',onUpdate:()=>renderAt(playhead.time)},0);
+timeline.pause(0);
+window.__timelines=window.__timelines||{};
+window.__timelines['m4_building-visibility-on-your-own']=timeline;
+window.__hyperframes={compositionId,timeline,duration:totalDuration};
+window.dispatchEvent(new CustomEvent('hyperframes:timeline-ready',{detail:{compositionId,timeline}}));
+</script></body></html>
